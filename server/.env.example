# MongoDB Configuration
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/atspeaks?retryWrites=true&w=majority
# OR use local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/atspeaks

# Email Configuration (Gmail)
# IMPORTANT: Use Gmail App Password, NOT your regular Gmail password!
# How to get Gmail App Password:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification (if not already enabled)
# 3. Go to https://myaccount.google.com/apppasswords
# 4. Select "Mail" and "Windows Computer" (or other device)
# 5. Copy the 16-character password generated
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password

# Environment
NODE_ENV=development
PORT=5000

# Sales Intern Recruitment Configuration
RECRUITMENT_EMAIL=connect.atspeaks@gmail.com
SALES_INTERN_WHATSAPP_URL=https://chat.whatsapp.com/EtsdMfwoC8oJWnQdHi0uO0

# Cloudinary (for secure resume & certificate storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Admin Dashboard Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_strong_password
ADMIN_JWT_SECRET=change_this_random_jwt_secret
